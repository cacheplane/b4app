# Read by Infra/scripts/deploy.sh (parsed, never sourced).
# INCLUDE_SIGNIN_SECRETS=1 adds the four sign-in secrets (B4HUB_SECRET_KEY and
# the three B4HUB_APPLE_* values) to the serving task definition, and to the
# admin task's `hub` container (hub-admin.json.tpl's gated block, rendered by
# admin-shell.sh). Both containers already set B4HUB_WEBAUTHN_RP_ID.
#
# The sign-in hub (its `serve` requires B4HUB_SECRET_KEY and
# B4HUB_WEBAUTHN_RP_ID) turned this on when it merged, together with the
# Compose profile's secret_key file (B4HUB_SECRET_KEY_FILE, generated by
# Hub/deploy/compose/test.sh) and the chart's kind install key
# (.github/scripts/chart-kind-test.sh). ECS refuses to start a task whose
# secret has no value, so Infra/README.md runbook 3 (set the sign-in secrets in
# each account) must be done before the first deploy.
#
# Not a flag here: the serving task's B4HUB_APPLE_CALLBACK_SCHEME (D-140) differs
# per environment, so deploy.sh sets it with the hostname (b4app-beta for test,
# b4app for prod) and Infra/modules/hub/ecs.tf does the same for Terraform. A hub
# that offers Apple's web flow exits 2 without it.
INCLUDE_SIGNIN_SECRETS=1

# INCLUDE_APNS_SECRETS=1 adds the three APNs secrets (B4HUB_APNS_KEY_ID,
# B4HUB_APNS_TEAM_ID, B4HUB_APNS_PRIVATE_KEY) and B4HUB_PUSH_SENDER=apns to the
# serving task definition only (the migrate and admin tasks send no pushes).
# ECS refuses to start a task whose secret has no value, so this lands in two
# steps: the PR that added the secrets shipped this at 0, which deploys a hub
# with no push sender; then the owner puts the three values in each account
# (Infra/README.md runbook 3a, "Set the APNs secrets"), and a one-line
# follow-up PR sets this to 1, test deployed before production.
INCLUDE_APNS_SECRETS=0
