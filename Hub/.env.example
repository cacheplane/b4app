# Copy to .env (git-ignored) and fill in both values before `docker compose up`.
# Both end up inside postgres:// URLs, so use URL-safe printable ASCII, for example:
#   openssl rand -hex 24
POSTGRES_PASSWORD=
B4HUB_APP_PASSWORD=

# Optional. Where the hub's Simulator notifications appear on this machine (default ./push-spool,
# which is git-ignored). Each is a `.apns` file for `xcrun simctl push`.
# B4HUB_PUSH_SPOOL_HOST_DIR=
