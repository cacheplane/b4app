# Copy to .env (git-ignored) and fill in every empty value before `docker compose up`.
# Both passwords end up inside postgres:// URLs, so use URL-safe printable ASCII, for example:
#   openssl rand -hex 24
POSTGRES_PASSWORD=
B4HUB_APP_PASSWORD=

# Sign-in. The secret key is 32 random bytes in base64 (openssl rand -base64 32); it seals what
# the hub keeps encrypted (Apple refresh tokens), so keep it. This Compose file passes the variable
# itself; the hub also reads B4HUB_SECRET_KEY_FILE, which deploy/compose/ uses.
B4HUB_SECRET_KEY=
# The passkey relying party: the site domain whose association file names the apps.
B4HUB_WEBAUTHN_RP_ID=local.b4.run
# open lets a new passkey create an account; the hub's own default is closed.
B4HUB_SIGNUP=open
# Sign in with Apple is off here (the local flavour hides it); Hub/API.md, "Sign-in", lists the
# B4HUB_APPLE_* variables a hub that offers it needs.

# Notifications. B4HUB_PUSH_SENDER is spool (the default) or apns.
#
# spool: the hub writes each notification as a `.apns` file for `xcrun simctl push`, and
# Scripts/sim-push.sh feeds them to the booted Simulator. No Apple account needed. Optional: where
# the files appear on this machine (default ./push-spool, which is git-ignored).
# B4HUB_PUSH_SPOOL_HOST_DIR=
#
# apns: the hub sends through Apple (sandbox tokens to api.sandbox.push.apple.com, production
# tokens to api.push.apple.com). Needs an APNs key from the Developer portal: its 10-character
# key id, your 10-character team id, and the downloaded .p8 file, which Compose mounts read-only
# into the hub as B4HUB_APNS_PRIVATE_KEY_FILE (the key itself never goes in this file). Uncomment
# and fill in all four, then `docker compose up -d hub`. The hub will not start with any missing.
# With spool the APNs values are ignored.
# B4HUB_PUSH_SENDER=apns
# B4HUB_APNS_KEY_ID=
# B4HUB_APNS_TEAM_ID=
# B4HUB_APNS_KEY_HOST_PATH=/absolute/path/to/AuthKey_<key id>.p8
