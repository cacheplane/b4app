# Copy to .env (git-ignored). Secrets do NOT go here; they are files under ./secrets/ (README.md).

# Image tag to run, for example 0.3.0 or sha-<commit>. Prefer a released tag over `main`.
B4HUB_VERSION=

# The URL clients use to reach the hub, and the WebAuthn relying-party id (its hostname).
B4HUB_PUBLIC_URL=https://hub.example.com
B4HUB_WEBAUTHN_RP_ID=hub.example.com

# `closed`: only operator-seeded users can enroll. Leave it closed unless you mean to allow
# self-service sign-up.
B4HUB_SIGNUP=closed

# Required when using the tls profile (Caddy; defaults to localhost otherwise): the hostname to
# obtain a certificate for. DNS must point here and ports 80 and 443 must be reachable.
CADDY_HOSTNAME=hub.example.com

# Loopback port for compose.local.yaml.
# B4HUB_LOCAL_PORT=8080
