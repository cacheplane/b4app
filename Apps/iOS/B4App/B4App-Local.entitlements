<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- local flavour: developer mode makes the device fetch the association file straight from the
       site instead of Apple's CDN, and there is no Sign in with Apple (Flavor.appleSignIn). -->
  <key>com.apple.developer.associated-domains</key>
  <array>
    <string>webcredentials:$(B4APP_SITE_DOMAIN)?mode=developer</string>
    <string>applinks:$(B4APP_SITE_DOMAIN)?mode=developer</string>
  </array>
</dict>
</plist>
